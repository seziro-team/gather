# ─────────────────────────────────────────────────────────────────────────────
# Gather — configuration
#
#   cp .env.example .env && docker compose up -d
#
# Every value below works as-is for a local run. The two you must change before
# putting Gather on the internet are GATHER_AUTH_SECRET and POSTGRES_PASSWORD.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────

# The URL your firm and your clients reach Gather on. Used to build magic links
# and to scope authentication cookies, so it must match the address in the
# browser exactly (scheme, host and port). Behind a reverse proxy this is your
# public https:// address, not the container's.
GATHER_APP_URL=http://localhost:3000

# Signs session cookies and two-factor state. Anyone holding this can forge a
# login, so it must be secret and unique to your install.
#
# Leave it empty and Gather generates one on first boot, storing it in the
# gather-data volume — the quickstart stays a single command and no install
# ships with a known secret. Set it explicitly (openssl rand -base64 48) if you
# want it in your own secret store, if you back up config but not volumes, or if
# you run more than one replica.
GATHER_AUTH_SECRET=

# Host port Gather listens on. Change if 3000 is taken.
GATHER_PORT=3000

# Who may create a firm account.
#   first-user-only  the very first sign-up claims the install; later ones are refused (default)
#   open             anyone who can reach the page can create an account — only for a trusted network
#   off              no new accounts at all
GATHER_ALLOW_SIGNUP=first-user-only

# Require every firm user to set up an authenticator app before reaching the
# dashboard. Gather handles tax documents; the FTC Safeguards Rule
# (16 CFR 314.4(c)(5)) requires multi-factor authentication for anyone accessing
# customer information, so this defaults to on. Turning it off is your call and
# is recorded in the audit log.
GATHER_REQUIRE_2FA=true

# debug | info | warn | error. Logs are one JSON object per line on stdout.
GATHER_LOG_LEVEL=info

# Apply pending database migrations automatically when Gather starts. Leave this
# on unless your operations process runs migrations separately — with it off,
# Gather boots but reports itself unhealthy until you run `pnpm db:migrate`.
GATHER_AUTO_MIGRATE=true

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres is the only service Gather requires. docker compose starts it for
# you; these credentials create it on first boot.

POSTGRES_USER=gather
POSTGRES_PASSWORD=gather
POSTGRES_DB=gather

# Host port the database is published on — bound to 127.0.0.1 only. This exists
# so tools on your machine (psql, pnpm verify:audit) can reach it.
POSTGRES_PORT=5432

# Used by tooling run on your machine, not by the containers: docker compose
# builds the container's own DATABASE_URL from the POSTGRES_* values above and
# points it at the "db" service.
DATABASE_URL=postgres://gather:gather@localhost:5432/gather

# ── Storage ──────────────────────────────────────────────────────────────────
# Where your clients' documents actually live. Encrypted at rest either way.

# local  a directory inside the gather-data volume. No extra services, and what
#        a firm on one server should use. (default)
# s3     any S3-compatible endpoint — AWS S3, Cloudflare R2, Backblaze B2,
#        Wasabi, SeaweedFS, an existing MinIO, or the Garage container in
#        docker-compose.s3.yml. Fill in the S3_* block below.
STORAGE_DRIVER=local

# Overrides where the local driver writes. Leave empty for the default,
# ${GATHER_DATA_DIR}/uploads, which is inside the volume compose already backs.
STORAGE_LOCAL_PATH=

# on   every file is encrypted with AES-256-GCM before it reaches the disk or
#      the bucket, using a per-file key wrapped by GATHER_ENCRYPTION_KEY.
#      16 CFR 314.4(c)(3) requires encryption at rest for customer information,
#      and it applies whatever storage you chose. (default)
# off  files are stored as-is. Only sensible if the storage underneath already
#      encrypts and you would rather have the bandwidth — with it off, uploads
#      can go browser-direct to S3 instead of streaming through Gather.
STORAGE_ENCRYPTION=on

# The master key wrapping every per-file key. Generate with:
#   openssl rand -base64 32
#
# ⚠️ WITHOUT THIS KEY THE DOCUMENTS CANNOT BE READ BY ANYONE, INCLUDING YOU.
#    Back it up somewhere that is not the server it protects.
#
# Left empty with STORAGE_DRIVER=local, the container generates one on first
# boot into the gather-data volume, next to the files — so the quickstart is
# still one command and the key and the data are backed up together.
# With STORAGE_DRIVER=s3 it MUST be set here: Gather refuses to generate a key
# it cannot store beside the objects, because a key that exists only in a
# container volume is a way to lose every document to `docker compose down -v`.
GATHER_ENCRYPTION_KEY=

# Largest single file a client may upload, in megabytes. A phone photo of a
# tax form is 2–5 MB; a scanned year of bank statements can be 60.
GATHER_MAX_UPLOAD_MB=100

# ── S3 (only when STORAGE_DRIVER=s3) ─────────────────────────────────────────
# Pointing at a bucket you already own: fill these in and leave
# docker-compose.s3.yml out of it.
#
# Using the bundled Garage container instead:
#   docker compose -f docker-compose.yml -f docker-compose.s3.yml up -d
# The values below are then the credentials Garage is told to accept, so any
# values work — but change them, because these are in a public example file.
# Garage requires the key id to start with "GK" followed by 24 hex characters,
# and the secret to be 64 hex characters:
#   printf 'GK%s\n' "$(openssl rand -hex 12)"   # key id
#   openssl rand -hex 32                        # secret

S3_BUCKET=
# The region name. Garage's own default is "garage"; AWS wants a real one.
S3_REGION=garage
# Leave empty for real AWS. For anything else, the endpoint URL —
# e.g. http://garage:3900, https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing (endpoint/bucket/key). Every self-hosted endpoint needs
# this. Set false only for real AWS S3 with a DNS-addressable bucket.
S3_FORCE_PATH_STYLE=true

# Garage's internal node-to-node authentication, used only by
# docker-compose.s3.yml. A 32-byte hex string:
#   openssl rand -hex 32
GARAGE_RPC_SECRET=

# ── Client portal ────────────────────────────────────────────────────────────
# The link a client clicks. No account, no password, no app — plan.md §1.

# How long a magic link keeps working before the firm has to issue a new one.
# A tax-season request that sits unanswered for a month is normal; one that is
# still open after a year is not.
GATHER_PORTAL_LINK_DAYS=30

# How long the session created by clicking a link lasts. This is what makes a
# borrowed or shared device forget the client eventually, so it is deliberately
# much shorter than the link itself.
GATHER_PORTAL_SESSION_HOURS=72

# ── Email ────────────────────────────────────────────────────────────────────
# Reminders are what Gather is for. Nothing below is needed to run it, but
# without email a firm has to send every portal link by hand.
#
# After setting these, run `pnpm check:email you@yourfirm.example`. It reads
# your SPF, DKIM and DMARC records, tells you exactly what to add if they are
# wrong, and sends a real test message. Reminders that land in spam are the
# most likely way a self-hosted Gather fails, and the only failure that is
# completely invisible until a client says "you never asked me for that".

# none    no email; the request page says so and offers no dead buttons (default)
# resend  the Resend API — easiest if you have no mail server
# smtp    any SMTP server, including your own
MAIL_DRIVER=none

# Who reminders come from. Must be a domain you control and have verified with
# whichever provider you chose, or your mail will be rejected or filed as spam.
#   MAIL_FROM=Delgado Bookkeeping <documents@delgado.example>
MAIL_FROM=

# Where a client's reply goes. Defaults to MAIL_FROM. Set it to a mailbox a
# human reads: every reminder invites the client to reply.
MAIL_REPLY_TO=

# The DKIM selector `pnpm check:email` looks for. Resend publishes under
# "resend"; your own mail server chose its own when you set up signing.
MAIL_DKIM_SELECTOR=resend

# ── Resend (only when MAIL_DRIVER=resend) ────────────────────────────────────
# Create a key at https://resend.com/api-keys and verify your sending domain at
# https://resend.com/domains first.
#
# ⚠️ The free tier is 3,000 emails a month BUT ONLY 100 A DAY. A firm sending
#    organizers to its client list in January will exceed that before lunch.
#    Pro ($20/mo) removes the daily cap. If you have your own mail server, SMTP
#    below has no such ceiling.
RESEND_API_KEY=

# From https://resend.com/webhooks — subscribe to email.delivered, email.bounced
# and email.complained, pointing at <GATHER_APP_URL>/api/webhooks/resend.
# Without it Gather knows a message was accepted but never whether it arrived.
RESEND_WEBHOOK_SECRET=

# ── SMTP (only when MAIL_DRIVER=smtp) ────────────────────────────────────────
SMTP_HOST=
# 587 with STARTTLS is the usual choice; 465 wants SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Only turn this off for a mail server on your own network using a self-signed
# certificate. Off means an attacker on the path can read your clients' names.
SMTP_REQUIRE_VALID_CERT=true

# ── Reminder worker ──────────────────────────────────────────────────────────
# The worker runs as its own container so a slow mail server cannot slow the
# app down. It needs no configuration beyond DATABASE_URL and the email
# settings above.

# How often it looks for schedules that have come due, in minutes. The cadence
# decides when a reminder is due; this only decides how promptly a due one is
# noticed — a firm setting "every 3 days at 09:00" cannot tell 09:00 from
# 09:00:59, so the default is fine and a busier install can widen it.
GATHER_REMINDER_SCAN_MINUTES=1

# Most reminders sent in one pass, so a backlog cannot become a sending burst
# that gets your domain rate-limited by its own provider.
GATHER_REMINDER_BATCH=50

# ── Antivirus ────────────────────────────────────────────────────────────────
# ⚠️ ClamAV wants 3 GiB of RAM minimum, 4 GiB preferred — more than the rest of
#    Gather combined. That is why it is opt-in rather than on by default: the
#    promise is that Gather runs on a cheap VPS.
#
#   docker compose -f docker-compose.yml -f docker-compose.antivirus.yml up -d
#
# With it on, an upload cannot be downloaded by anyone — including you — until
# it has been scanned, and an infected file is quarantined: the record and the
# audit event stay as evidence, the bytes are deleted, and the client is told.
#
# With it off, every file is marked "skipped" and the interface says "Not
# scanned" next to it. It is never silently treated as clean.
ANTIVIRUS_DRIVER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# A 100 MB scan is not instant, and a timeout that fires mid-scan leaves the
# file quarantined until somebody looks at it.
CLAMAV_TIMEOUT_MS=120000

# ── Security ─────────────────────────────────────────────────────────────────

# Believe X-Forwarded-For / X-Real-IP for the client's address.
#
# ⚠️ Turn this on ONLY when something you control terminates the connection in
#    front of Gather (Caddy, nginx, a load balancer). With it on and no proxy,
#    anyone can set the header and choose which rate-limit bucket they land in.
#
# With it off, Gather cannot tell one client from another, so the per-IP limit
# on magic-link redemption falls back to a much higher shared ceiling. That is
# deliberate: applying a per-IP number to everybody would lock a firm's own
# clients out of their own documents.
GATHER_TRUST_PROXY=false

# Rate limiting on link redemption, uploads, autosaves, downloads and exports.
# Turn it off only for a load test you are running against your own install.
GATHER_RATE_LIMIT=true

# Rate limiting on sign-in, sign-up and two-factor specifically. Separate because
# the numbers are much tighter — three sign-ups per five minutes, five sign-in
# attempts a minute.
#
# ⚠️ Never turn this off on an install anyone else can reach. It is the only
#    thing between a password and an unlimited number of guesses.
GATHER_AUTH_RATE_LIMIT=true

# Mailpit's inbox UI, when you run docker-compose.mail.yml — a real SMTP server
# that catches instead of relaying, for development and for the test suite.
# Change it if 8025 is already taken on your machine; the end-to-end tests read
# this variable rather than assuming a port.
MAILPIT_UI_PORT=8025

# ── Retention ────────────────────────────────────────────────────────────────
# How long a COMPLETED request's files are kept before `retention:purge` will
# dispose of them. The file record — name, size, SHA-256 — and the audit trail
# survive, because "there was a document here and it was disposed of on this
# date" is the record 16 CFR 314.4(c)(6) disposal is meant to leave behind.
#
# 0 means never, and it is the default: deleting a firm's client documents on a
# timer the firm did not set is not a decision Gather gets to make.
#
# Nothing happens automatically. Run it yourself, inside the container so it can
# reach the stored files:
#   docker compose exec worker node dist/cli/retention-purge.js            # dry run
#   docker compose exec worker node dist/cli/retention-purge.js --confirm
GATHER_RETENTION_DAYS=0

# ── Gather Cloud (the hosted tier — leave off for a self-hosted install) ─────
# Everything below is for running Gather AS A SERVICE for other firms. If you are
# a firm running Gather for yourself, stop here: leave GATHER_CLOUD=false and you
# have the whole product, with no seat limit, no storage cap, and no billing.
#
# Turning it on adds three things and nothing else:
#   • plan limits (seats and storage) for firms on this install
#   • a billing page, backed by Stripe
#   • an operator console at /admin for whoever runs the service
#
# The app refuses to boot with GATHER_CLOUD=true and the Stripe keys missing —
# a payment button that errors is worse than no payment button.
GATHER_CLOUD=false

# Stripe. Test-mode keys (sk_test_…) until you are actually charging people.
#   Secret key:     https://dashboard.stripe.com/test/apikeys
#   Webhook secret: https://dashboard.stripe.com/test/webhooks — add an endpoint
#                   at <GATHER_APP_URL>/api/webhooks/stripe subscribed to
#                   checkout.session.completed and customer.subscription.*
#   Price ids:      create two recurring prices (Gather Cloud, Gather Cloud Pro)
#                   at https://dashboard.stripe.com/test/products and paste the
#                   price ids (price_…), not the product ids (prod_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CLOUD=
STRIPE_PRICE_CLOUD_PRO=

# Who may open /admin, comma-separated. Two forms:
#   ops@seziro.com            one address
#   @seziro.com               everybody at that domain
#
# ⚠️ Only list a domain whose mailboxes you control. Gather does not verify
#    email addresses at sign-up, so "@gmail.com" here would hand the operator
#    console to anyone who asked for it.
#
# Empty means nobody, which is what a self-hosted install wants — there is no
# back door into your firm's data because there is no account that could use one.
GATHER_ADMIN_EMAILS=
